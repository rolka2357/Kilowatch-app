%%{init: {'flowchart': {'curve': 'linear'}, 'themeVariables': {
  'primaryColor': '#ffffff',
  'primaryBorderColor': '#000000',
  'primaryTextColor': '#000000',
  'lineColor': '#000000',
  'textColor': '#000000',
  'edgeLabelBackground': '#ffffff'
}}}%%
flowchart TD
    classDef bw fill:#ffffff,stroke:#000000,stroke-width:1.2px,color:#000000;

    A(["Start: Open Room\nTips Detail (roomId)"]):::bw
    B["Show loading spinner\nwhile tips data loads"]:::bw
    C{"Room found in\ncached tips data?"}:::bw

    A --> B --> C
    C -- "No" --> D["Show 'No tips for this\nroom yet — go back and\ngenerate tips first'"]:::bw --> E(["End"]):::bw

    C -- "Yes" --> F["Show header with room name"]:::bw
    F --> G["Show summary: room used\n~X% of registered-appliance\nconsumption"]:::bw
    G --> H["Show stats: This Week,\nAvg Consumption,\nVs. Last Week"]:::bw
    H --> I{"Spending faster\nthan expected for\nthis room?"}:::bw
    I -- "Yes" --> J["Show warning box:\n'You're spending faster than\nexpected — review your budget'"]:::bw
    I -- "No" --> K["No warning shown"]:::bw

    J --> L["List generated tip cards\nfor this room (title + body)"]:::bw
    K --> L
    L --> M(["User reads tips\n(no further navigation)"]):::bw

    linkStyle default stroke:#000000,stroke-width:1.2px,fill:none;
