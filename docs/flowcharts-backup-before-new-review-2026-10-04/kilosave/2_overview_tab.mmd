%%{init: {'flowchart': {'curve': 'linear'}, 'themeVariables': {
  'primaryColor': '#ffffff',
  'primaryBorderColor': '#000000',
  'primaryTextColor': '#000000',
  'lineColor': '#000000',
  'textColor': '#000000',
  'edgeLabelBackground': '#ffffff'
}}}%%
flowchart TD
    classDef bw fill:#ffffff,stroke:#000000,stroke-width:1.2px,color:#000000;

    A(["Start: Overview Tab\n(hasGoal = true)"]):::bw
    B["Show circular progress ring:\n₱ saved so far vs monthly goal"]:::bw
    C["Show 'Remaining' and\n'Target Goal' amounts"]:::bw
    D{"Can edit?"}:::bw
    D -- "Yes" --> E["Show 'Edit Target Goal'\nbutton"]:::bw
    E -- "Tap" --> Z1(["Go to Set Budget Goal"]):::bw

    A --> B --> C --> D
    D --> F{"Has the 4-week\nbilling period ended?"}:::bw

    F -- "Yes" --> G["Show 'This billing period\nhas ended' card"]:::bw
    G --> H{"Can edit?"}:::bw
    H -- "Yes" --> I["Show 'Start a new period'\nbutton --> Set Budget Goal\n(forces new period)"]:::bw
    H -- "No" --> J["No action available"]:::bw

    F -- "No" --> K{"Has this week's\nset-aside been saved?"}:::bw

    K -- "Yes" --> L["Show success banner:\n'Well Done! You've set\naside your first money'"]:::bw
    L --> M["Show placeholder card:\n'Next week's reminder\nwill show here'"]:::bw
    M --> N["Tap 'How does this\nhelp me?' --> Show info alert"]:::bw

    K -- "No" --> O{"Is it within the\nset-aside reminder\nwindow for this week?"}:::bw

    O -- "Yes" --> P["Show 'This week's set aside\nreminder!' card with amount"]:::bw
    P --> Q{"Can edit?"}:::bw
    Q -- "Yes" --> R["Tap 'Set Aside Money'"]:::bw --> Z2(["Go to Set Aside\nMoney screen"]):::bw
    Q -- "No" --> S["Button hidden"]:::bw

    O -- "No" --> T["Show placeholder reminder card\n+ 'How does this help?' info\n+ (if canEdit) 'Set aside\nthis week early' link"]:::bw
    T -- "Tap link" --> Z2

    F --> U{"Streak > 1 week\nin a row?"}:::bw
    U -- "Yes" --> V["Show flame streak box:\n'N-week streak!'"]:::bw
    U -- "No" --> W["No streak box"]:::bw

    V --> X["Show Week List:\nall 4 weeks in period with\nsaved/pending status and amount"]:::bw
    W --> X
    G --> X
    L --> X
    P --> X
    T --> X

    linkStyle default stroke:#000000,stroke-width:1.2px,fill:none;
