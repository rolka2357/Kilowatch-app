%%{init: {'flowchart': {'curve': 'linear'}, 'themeVariables': {
  'primaryColor': '#ffffff',
  'primaryBorderColor': '#000000',
  'primaryTextColor': '#000000',
  'lineColor': '#000000',
  'textColor': '#000000',
  'edgeLabelBackground': '#ffffff'
}}}%%
flowchart TD
    classDef bw fill:#ffffff,stroke:#000000,stroke-width:1.2px,color:#000000;

    A(["Start: Enter Appliance Detail\n(from Room Appliances card tap)"]):::bw
    B["Display energy gauge (kWh/Php\ntoggle) + stats + Power card\n(Active / Inactive / Offline)"]:::bw
    C{"User taps"}:::bw

    A --> B --> C

    C -- "Tap back arrow" --> Z1(["Return to Room Appliances"]):::bw

    C -- "Tap Turn On / Turn Off" --> D{"Editor access AND\nplug reachable?"}:::bw
    D -- "No" --> B
    D -- "Yes" --> E["Send Tuya on/off command"]:::bw
    E --> F{"Command\nsucceeded?"}:::bw
    F -- "Yes" --> G["Update switch state\nin database"]:::bw --> B
    F -- "No" --> H["Refresh Tuya session\nand home sync, retry command"]:::bw
    H --> I{"Retry\nsucceeded?"}:::bw
    I -- "Yes" --> G
    I -- "No" --> J["Show 'Unable to control'\nalert"]:::bw --> B

    C -- "Tap Set Limit\n(Usage Limit card)" --> Z2(["Go to Usage Limit flowchart"]):::bw
    C -- "Tap Set Time\n(Schedule card)" --> Z3(["Go to Schedule flowchart"]):::bw
    C -- "Tap View Appliance Analytics" --> Z4(["Go to Analytics flowchart\n(Appliance Analytics)"]):::bw

    C -- "Tap pencil (Edit)" --> K["Edit Appliance modal:\nedit appliance name +\nroom/location name"]:::bw
    K --> L{"Name and location\nboth filled in?"}:::bw
    L -- "No" --> L1["Show error message"]:::bw --> K
    L -- "Yes" --> M["Save appliance name and\nroom name to database"]:::bw --> B

    linkStyle default stroke:#000000,stroke-width:1.2px,fill:none;
