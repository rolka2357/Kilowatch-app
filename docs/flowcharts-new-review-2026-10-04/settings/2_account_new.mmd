%%{init: {'flowchart': {'curve': 'linear'}, 'themeVariables': {
  'primaryColor': '#ffffff',
  'primaryBorderColor': '#000000',
  'primaryTextColor': '#000000',
  'lineColor': '#000000',
  'textColor': '#000000',
  'edgeLabelBackground': '#ffffff'
}}}%%
flowchart TD
    classDef bw fill:#ffffff,stroke:#000000,stroke-width:1.2px,color:#000000;

    A(["Start: Open Account screen"]):::bw
    B["Load profile: name, email,\nphoto URL, verification status"]:::bw
    C["Show profile avatar\n(photo or initials)"]:::bw
    D{"User taps"}:::bw

    A --> B --> C --> D

    D -- "Tap avatar / 'Upload\nor Change photo'" --> E{"Photo library\npermission granted?"}:::bw
    E -- "No" --> F["Alert: 'Permission needed —\nallow photo library access'"]:::bw --> C
    E -- "Yes" --> G["Pick image, crop to\nsquare, upload to storage"]:::bw
    G --> H{"Upload\nsuccessful?"}:::bw
    H -- "Yes" --> I["Update profile photo URL\n(+ fan-out display name sync\nacross homes when name changes)"]:::bw --> C
    H -- "No" --> J["Alert: 'Upload failed'"]:::bw --> C

    D -- "Tap 'Remove'\n(if photo set)" --> K["Confirm: 'Remove photo?\nShows initials instead'"]:::bw
    K -- "Cancel" --> C
    K -- "Remove" --> L["Delete photo from storage\nand clear profile photo URL"]:::bw --> C

    D -- "Tap 'Name'" --> Z1(["Go to Edit Name\n(see diagram 3)"]):::bw
    D -- "Tap 'Email Address'" --> Z2(["Go to Edit Email\n(see diagram 3)"]):::bw
    D -- "Tap 'Transfer Ownership'" --> T{"Is current user\nhome Owner?"}:::bw
    T -- "No" --> T1["Transfer control hidden\nor unavailable"]:::bw --> C
    T -- "Yes" --> T2(["Go to Transfer Ownership:\nchoose Editor/member,\nconfirm; previous owner\nbecomes Editor"]):::bw

    D -- "Tap 'Log Out'" --> N["Log out of Tuya session,\nclear saved session UID,\nsign out of Google,\nsign out of Firebase Auth"]:::bw
    N --> O{"Logout\nsuccessful?"}:::bw
    O -- "Yes" --> Z3(["App returns to\nLogin screen"]):::bw
    O -- "No" --> P["Alert: 'Logout failed'"]:::bw --> C

    linkStyle default stroke:#000000,stroke-width:1.2px,fill:none;
