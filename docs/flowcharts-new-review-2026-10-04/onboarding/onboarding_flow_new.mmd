%%{init: {'flowchart': {'curve': 'linear'}, 'themeVariables': {
  'primaryColor': '#ffffff',
  'primaryBorderColor': '#000000',
  'primaryTextColor': '#000000',
  'lineColor': '#000000',
  'textColor': '#000000',
  'edgeLabelBackground': '#ffffff'
}}}%%
flowchart TD
    classDef bw fill:#ffffff,stroke:#000000,stroke-width:1.2px,color:#000000;

    A(["Start: New user finishes\nAuth registration / first login\nwithout onboardingCompleted"]):::bw
    B(["Welcome Onboarding"]):::bw
    C(["Video Onboarding"]):::bw
    D(["Provider / Rate Onboarding"]):::bw
    E(["Permissions Onboarding"]):::bw
    F(["Bill Arrival Onboarding"]):::bw
    Z(["Enter Main App\n(MainTabs)"]):::bw

    A --> B
    B -- "Continue" --> C

    C --> C1{"User action"}:::bw
    C1 -- "Watch tutorial\n(openURL from\ncontent/onboarding/\ntutorialVideoUrl)" --> C2["Open video in browser /\nexternal player"]:::bw --> C
    C1 -- "Continue" --> D
    C1 -- "Skip" --> E

    D --> D1{"User chooses"}:::bw
    D1 -- "Select provider / rate\n(or custom ₱/kWh)" --> D2["Save electricity rate\nto profile"]:::bw --> E
    D1 -- "Use defaults /\nskip path" --> E

    E --> E1["Prompt notification /\nrequired app permissions"]:::bw
    E1 --> E2{"User continues\n(Allow or Skip UI)"}:::bw
    E2 --> F

    F --> F1["Ask bill arrival month/day\n(billing period for KiloSave)"]:::bw
    F1 --> F2{"User action"}:::bw
    F2 -- "Save day" --> F3["Write billingDayOfMonth +\nlastBillArrivalDate;\nmark onboarding complete"]:::bw --> Z
    F2 -- "Skip" --> F4["Complete onboarding\nwithout bill day\n(can set later in Settings\n> Billing period)"]:::bw --> Z

    linkStyle default stroke:#000000,stroke-width:1.2px,fill:none;
