%%{init: {'flowchart': {'curve': 'linear'}, 'themeVariables': {
  'primaryColor': '#ffffff',
  'primaryBorderColor': '#000000',
  'primaryTextColor': '#000000',
  'lineColor': '#000000',
  'textColor': '#000000',
  'edgeLabelBackground': '#ffffff'
}}}%%
flowchart TD
    classDef bw fill:#ffffff,stroke:#000000,stroke-width:1.2px,color:#000000;

    A(["Start"]):::bw
    B["Display Login Screen"]:::bw
    C{"User taps"}:::bw
    D{"Email and Password\nboth filled in?"}:::bw
    E["Show inline field error(s)"]:::bw
    F["Call Firebase\nsignInWithEmailAndPassword"]:::bw
    G{"Sign-in\nsuccessful?"}:::bw
    H["Determine error message\n(No account found / Incorrect\nemail or password / Invalid\nemail / Network error / Other)"]:::bw
    I["Display error message"]:::bw
    J["Tap Google Sign-In icon"]:::bw
    K["Call Firebase\nsignInWithGoogle"]:::bw
    L{"Google sign-in\nsuccessful?"}:::bw
    M["Display Google\nsign-in error message"]:::bw
    N(["Proceed to Main App\n(Home / Onboarding)"]):::bw
    O(["Go to Register Screen"]):::bw
    P(["Go to Forgot Password Screen"]):::bw

    A --> B --> C
    C -- "Enter credentials, tap Log In" --> D
    D -- "No" --> E --> B
    D -- "Yes" --> F --> G
    G -- "Yes" --> N
    G -- "No" --> H --> I --> B

    C -- "Tap Google icon" --> J --> K --> L
    L -- "Yes" --> N
    L -- "No" --> M --> B

    C -- "Tap Register Account" --> O
    C -- "Tap Forgot your Password?" --> P

    linkStyle default stroke:#000000,stroke-width:1.2px,fill:none;
