%%{init: {'flowchart': {'curve': 'linear'}, 'themeVariables': {
  'primaryColor': '#ffffff',
  'primaryBorderColor': '#000000',
  'primaryTextColor': '#000000',
  'lineColor': '#000000',
  'textColor': '#000000',
  'edgeLabelBackground': '#ffffff'
}}}%%
flowchart TD
    classDef bw fill:#ffffff,stroke:#000000,stroke-width:1.2px,color:#000000;

    A(["Start"]):::bw
    B["Display Forgot Password Screen\n(email pre-filled if coming from Login)"]:::bw
    C{"User taps"}:::bw
    D{"Is email valid?"}:::bw
    E["Show inline email error"]:::bw
    F["Call Firebase\nsendPasswordResetEmail"]:::bw
    G{"Request sent OR\naccount not found?"}:::bw
    H["Show 'Check your email' alert"]:::bw
    I["Change button label to\n'Resend Reset Link'"]:::bw
    J["Display error message\n(Invalid email / Too many\nattempts / Network error / Other)"]:::bw
    K(["Go to Login Screen"]):::bw

    A --> B --> C
    C -- "Tap Log In / Back to Log In" --> K
    C -- "Tap Send Reset Link" --> D
    D -- "No" --> E --> B
    D -- "Yes" --> F --> G
    G -- "Yes" --> H --> I --> B
    G -- "No" --> J --> B

    linkStyle default stroke:#000000,stroke-width:1.2px,fill:none;
