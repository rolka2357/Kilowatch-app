# Tuya IoT Platform cloud project credentials (iot.tuya.com -> Cloud -> your project)
TUYA_ACCESS_ID=your_access_id
TUYA_ACCESS_SECRET=your_access_secret

# Tuya data center endpoint. Must match the data center of your cloud project.
# Philippines accounts are usually on the US (Western America) data center:
#   https://openapi.tuyaus.com   (Western America)
#   https://openapi.tuyaeu.com   (Central Europe)
#   https://openapi.tuyacn.com   (China)
#   https://openapi-sg.iotbing.com (Singapore)
TUYA_API_ENDPOINT=https://openapi.tuyaus.com

# Firebase Realtime Database URL (same one as in the app's firebaseConfig.js)
FIREBASE_DATABASE_URL=https://energy-monitoring-system-f182d-default-rtdb.asia-southeast1.firebasedatabase.app

# Path to the Firebase service account key JSON (downloaded from
# Firebase Console -> Project settings -> Service accounts -> Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# How often to poll each smart plug, in milliseconds. 15000 = every 15 seconds.
POLL_INTERVAL_MS=15000

# Digital-meter calibration (defense accuracy). 1 = no change.
# factor = meterReading / tuyaRawReading  (average of 3 loads recommended)
# Example from one mid load: POWER 80.4/54.8 ≈ 1.467, VOLTAGE 255.4/227.3 ≈ 1.124
POWER_CALIBRATION=1
VOLTAGE_CALIBRATION=1

# Wall-clock timezone for schedules + usage-limit day keys (must match user phones).
APP_TIMEZONE=Asia/Manila

# Backend-driven KiloSave FCM reminders. The worker checks every five minutes
# after 9:00 AM local time and uses RTDB delivery markers to prevent duplicates.
KILOSAVE_REMINDER_HOUR=9
KILOSAVE_CHECK_INTERVAL_MS=300000

# Fallback ₱/kWh when the home owner has not set electricityRate in their profile.
PHP_PER_KWH=15
